# Safe local development defaults. Replace every secret in production.
NODE_ENV=development
APP_ENV=development
APP_NAME=Sintacks Books
APP_VERSION=0.1.0

WEB_PORT=5185
API_PORT=3010
STORYBOOK_PORT=6010
WEB_PUBLIC_API_BASE_URL=http://localhost:3010
API_PUBLIC_URL=http://localhost:3010
WEB_PUBLIC_URL=http://localhost:5185
API_CORS_ORIGINS=http://localhost:5185,http://localhost:6010

POSTGRES_HOST=localhost
POSTGRES_PORT=5440
POSTGRES_DB=sintacks_books_dev
POSTGRES_USER=sintacks_app
POSTGRES_PASSWORD=replace-in-production
DATABASE_URL=postgresql://sintacks_app:replace-in-production@localhost:5440/sintacks_books_dev?schema=public

REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_URL=redis://localhost:6390

S3_ENDPOINT=http://localhost:9010
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=sintacks-dev
S3_SECRET_ACCESS_KEY=replace-in-production
S3_BUCKET=sintacks-books-dev
S3_FORCE_PATH_STYLE=true

MINIO_ROOT_USER=sintacks-dev
MINIO_ROOT_PASSWORD=replace-in-production
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

MAILPIT_SMTP_PORT=1030
MAILPIT_WEB_PORT=8030
SMTP_HOST=localhost
SMTP_PORT=1030
EMAIL_FROM=development@sintacks.invalid

BETTER_AUTH_SECRET=replace-in-production
BETTER_AUTH_URL=http://localhost:3010

SENTRY_DSN=
TRUST_PROXY=false
SERVE_WEB_STATIC=false
