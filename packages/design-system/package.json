{
  "name": "@sintacks/design-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/index.css",
    "./tokens": "./src/tokens/index.css",
    "./tokens/primitive": "./src/tokens/primitive/index.css",
    "./tokens/semantic": "./src/tokens/semantic/index.css",
    "./themes": "./src/tokens/themes/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests",
    "clean": "rimraf dist"
  },
  "peerDependencies": {
    "lucide-react": "^1.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "lucide-react": "^1.32.0"
  }
}
