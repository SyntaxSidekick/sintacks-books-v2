{
  "name": "@sintacks/storybook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6010 --host 0.0.0.0",
    "storybook": "storybook dev -p 6010 --host 0.0.0.0",
    "build": "storybook build --disable-telemetry",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "test:integration": "vitest run --passWithNoTests",
    "clean": "rimraf storybook-static"
  },
  "dependencies": {
    "@sintacks/design-system": "workspace:*",
    "@storybook/addon-docs": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "lucide-react": "^1.32.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "storybook": "^9.1.3"
  },
  "devDependencies": {
    "vite": "^7.1.3"
  }
}
